# Environment Configuration Template
# Copy this file to .env and update the values

# =============================================================================
# SECRET KEYS
# =============================================================================
SECRET_KEY=your-super-secret-key-change-in-production

# =============================================================================
# DATABASE PASSWORDS
# =============================================================================

# Salesforce CRM Database
SALESFORCE_DB_PASSWORD=salesforce_secret

# MuleSoft Integration Database
MULESOFT_DB_PASSWORD=mulesoft_secret

# ServiceNow ITSM Database
SERVICENOW_DB_PASSWORD=servicenow_secret

# =============================================================================
# EXTERNAL INTEGRATION (Optional)
# =============================================================================

# MuleSoft API Configuration
MULESOFT_CLIENT_ID=your-mulesoft-client-id
MULESOFT_CLIENT_SECRET=your-mulesoft-client-secret
MULESOFT_BASE_URL=https://your-mulesoft-instance.cloudhub.io

# SAP Configuration
SAP_BASE_URL=https://your-sap-instance.com
SAP_CLIENT=100
SAP_USERNAME=sap_user
SAP_PASSWORD=sap_password

# ServiceNow Configuration
SERVICENOW_INSTANCE=dev12345
SERVICENOW_USERNAME=admin
SERVICENOW_PASSWORD=servicenow_password
